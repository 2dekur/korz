{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Korz Manager",
  "identifier": "com.korz.admin",
  "version": "0.0.1",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Korz Manager",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["../src-tauri/icons/32x32.png", "../src-tauri/icons/128x128.png"]
  }
}
