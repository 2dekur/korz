{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    "fs:default",
    "dialog:default",
    "os:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.deezer.com/*"
        },
        {
          "url": "https://itunes.apple.com/*"
        }
      ]
    },
    "fs:allow-read-dir",
    "fs:allow-stat"
  ]
}
