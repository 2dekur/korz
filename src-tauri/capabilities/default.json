{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core IPC, folder picker, reveal the log folder, open YouTube/Spotify pages of a pasted link.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.youtube.com/*"
        },
        {
          "url": "https://open.spotify.com/*"
        }
      ]
    }
  ]
}
